# Copier ce fichier en .env et renseigner les vraies valeurs (jamais commité)

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Connexion PostgreSQL
DATABASE_URL=postgresql://agent_veille:agent_veille_dev_pw@localhost:5432/agent_veille

# Modèle par défaut (utilisé si aucune variable spécifique ci-dessous n'est définie)
ANTHROPIC_MODEL=claude-opus-5

# Routage par tâche (optionnel) — pour tester le coût/qualité par modèle.
# Non définies, elles retombent sur ANTHROPIC_MODEL (sauf le scan réactif,
# qui utilise Haiku par défaut : c'est la tâche la plus fréquente et la
# moins exigeante en jugement).
# ANTHROPIC_MODEL_VEILLE=claude-opus-5
# ANTHROPIC_MODEL_REDACTION=claude-opus-5
# ANTHROPIC_MODEL_VERIFICATION=claude-opus-5
# ANTHROPIC_MODEL_SCAN_REACTIF=claude-haiku-4-5
