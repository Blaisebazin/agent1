# Variables lues par docker-compose.yml — copier en .env à la racine.

# Mot de passe PostgreSQL (choisir une valeur forte en production)
POSTGRES_PASSWORD=

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Sonnet 5 : ~40% moins cher qu'Opus, qualité jugée suffisante sur nos
# tests de rédaction/vérification — à recalibrer après usage réel.
ANTHROPIC_MODEL=claude-sonnet-5

# Optionnel — intégration Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Nom de domaine pointant vers ce VPS (ex. mon-site.fr) pour un certificat
# TLS automatique via Caddy. Laisser à ":80" pour tester en local.
SITE_DOMAIN=:80

# Optionnel — variante www (ex. www.mon-site.fr). Nécessite un
# enregistrement DNS CNAME "www" pointant vers le domaine principal.
# Non définie, elle reprend SITE_DOMAIN.
SITE_DOMAIN_WWW=
