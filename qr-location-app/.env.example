# Secret que toi seul connais, pour publier un nouveau statut depuis la page admin.
ADMIN_TOKEN=change-moi

# Port d'ecoute du serveur.
PORT=3000

# URL publique complete de l'app une fois deployee (ex: https://ou-je-suis.mondomaine.fr).
# Utilisee pour encoder le QR code. Si absente, l'URL de la requete entrante est utilisee
# (pratique en local, mais a definir explicitement en production derriere un proxy).
PUBLIC_URL=
